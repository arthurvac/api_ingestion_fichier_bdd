# Facultatif : valeurs de développement local par défaut.
ENVIRONMENT=development
POSTGRES_DB=ingestion_db
POSTGRES_USER=ingestion_user
POSTGRES_PASSWORD=ingestion_dev_password
POSTGRES_PORT=5432
API_PORT=8000
DATABASE_URL=postgresql+psycopg://ingestion_user:ingestion_dev_password@db:5432/ingestion_db
# Hors Docker, utiliser 127.0.0.1 au lieu de db.
MAX_UPLOAD_BYTES=10485760
MAX_XLSX_UNCOMPRESSED_BYTES=52428800
MAX_ROWS=100000
MAX_COLUMNS=256
MAX_HEADER_ROWS=20
MAX_RECORD_BYTES=1048576
MAX_ERRORS=50
MAX_ACTIVE_UPLOADS=2
IMPORT_TIMEOUT_SECONDS=900
DATABASE_LOCK_TIMEOUT_SECONDS=5
# Limites Docker par instance, PostgreSQL et système comptés séparément.
API_MEMORY_LIMIT_MIB=2048
API_CPU_LIMIT=1.0
# TEST_DATABASE_URL est exclusivement réservé à la base/utilisateur ingestion_test.
